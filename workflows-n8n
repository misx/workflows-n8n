    {
      "parameters": {
        "jsCode": "// ============================================================\n// FILTRAGE : Détection liens WhatsApp dans la bio/website\n// ============================================================\nconst items = $input.all();\nconst withWA = [];\n\nconst waPatterns = [\n  { regex: /wa\\.me\\/(\\d+)/i, type: \"wa.me\" },\n  { regex: /wa\\.link\\/([\\w-]+)/i, type: \"wa.link\" },\n  { regex: /whatsapp/i, type: \"mention\" },\n  { regex: /watsap/i, type: \"mention\" }\n];\n\nfor (const item of items) {\n  if (item.json._empty) continue;\n  const p = item.json;\n  const text = `${p.bio} ${p.website}`.toLowerCase();\n\n  let waLink = null;\n  let waPhone = null;\n  let waType = null;\n\n  for (const pattern of waPatterns) {\n    const match = text.match(pattern.regex);\n    if (match) {\n      waType = pattern.type;\n      if (pattern.type === \"wa.me\") {\n        waPhone = match[1];\n        waLink = `https://wa.me/${waPhone}`;\n      } else if (pattern.type === \"wa.link\") {\n        waLink = `https://wa.link/${match[1]}`;\n      } else {\n        waLink = p.website || \"mention dans bio\";\n      }\n      break;\n    }\n  }\n\n  if (waLink) {\n    withWA.push({\n      json: {\n        ...p,\n        whatsappLink: waLink,\n        whatsappPhone: waPhone,\n        whatsappType: waType\n      }\n    });\n    console.log(`[FILTRAGE ✅] @${p.username} → ${waType} → ${waLink}`);\n  } else {\n    console.log(`[FILTRAGE ❌] @${p.username} → Pas de WhatsApp détecté`);\n  }\n}\n\nconsole.log(`[FILTRAGE] Total avec WhatsApp: ${withWA.length}`);\n\nif (withWA.length === 0) {\n  return [{ json: { _empty: true, message: \"Aucun compte avec WhatsApp dans ce run\" } }];\n}\n\nreturn withWA;"
      },
