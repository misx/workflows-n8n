      "parameters": {
        "jsCode": "// ============================================================\n// EXTRACTION ET NORMALISATION DES PROFILS APIFY\n// ============================================================\nconst items = $input.all();\nconst config = $('⚙️ Configuration').item.json;\nconst profiles = [];\n\nfor (const item of items) {\n  const posts = Array.isArray(item.json) ? item.json : [item.json];\n\n  for (const post of posts) {\n    if (!post || !post.ownerUsername) continue;\n\n    // Apify retourne ces champs pour chaque post\n    profiles.push({\n      json: {\n        username: post.ownerUsername || post.username || \"\",\n        bio: post.ownerBiography || post.biography || \"\",\n        website: post.ownerExternalUrl || post.website || \"\",\n        followersCount: post.ownerFollowersCount || 0,\n        fullName: post.ownerFullName || \"\",\n        isVerified: post.ownerIsVerified || false,\n        instagramUrl: `https://instagram.com/${post.ownerUsername}`,\n        scrapedHashtag: post.hashtags?.[0] || config.currentHashtag || \"\",\n        postLikes: post.likesCount || 0,\n        postUrl: post.url || \"\",\n        scrapedAt: new Date().toISOString(),\n        // Config transmise\n        evolutionApiUrl: config.evolutionApiUrl,\n        evolutionApiKey: config.evolutionApiKey,\n        evolutionInstance: config.evolutionInstance,\n        whatsappTestMessage: config.whatsappTestMessage,\n        maxAccountsPerRun: config.maxAccountsPerRun\n      }\n    });\n  }\n}\n\n// Dédoublonnage par username\nconst seen = new Set();\nconst unique = profiles.filter(p => {\n  if (seen.has(p.json.username)) return false;\n  seen.add(p.json.username);\n  return true;\n});\n\n// Limite par run\nconst limited = unique.slice(0, config.maxAccountsPerRun);\nconsole.log(`[APIFY] Posts récupérés: ${profiles.length} | Uniques: ${unique.length} | Après limite: ${limited.length}`);\n\nif (limited.length === 0) {\n  return [{ json: { _empty: true, message: \"Aucun profil récupéré par Apify\" } }];\n}\n\nreturn limited;"
      },
